{
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "nodenext",
    "target": "es2024",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "moduleResolution": "node16"
  },
  "include": ["src", "test", "types.ts", "../types.ts", "main.ts", "migrate.ts"]
}
