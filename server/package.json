{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch --coverage",
    "dev": "nodemon -L -e ts -r dotenv/config",
    "build": "tsc",
    "postbuild": "npm run copyCerts && npm run copyMigrations",
    "copyCerts": "cp -a src/service/crt/ dist/server/src/service/crt/",
    "copyMigrations": "cp -a migrations dist/server/migrations/",
    "migrate:tool": "node-pg-migrate -j sql",
    "migrate:local": "ts-node migrate.ts",
    "migrate:cloud": "node dist/server/migrate.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@socket.io/admin-ui": "^0.5.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.13",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@socket.io/redis-streams-adapter": "^0.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.2",
    "node-pg-migrate": "7.6.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  }
}
