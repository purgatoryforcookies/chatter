# Every system's docker compose variables, set in one place. Values here
# override the defaults in each system's compose file.

# chatter (systems/chatter)
CHATTER_REDIS_HOST_PORT=6379
CHATTER_DB_HOST_PORT=5432
CHATTER_POSTGRES_USER=postgres
CHATTER_POSTGRES_PASSWORD=postgres
CHATTER_POSTGRES_DB=postgres
CHATTER_SERVER_HOST_PORT=3000
CHATTER_DEVELOPMENT=false
CHATTER_AUTH_ISSUER_URI=https://test.remote.com
CHATTER_AUTH_AUDIENCE=chat
CHATTER_JWT_SECRET=kissa
CHATTER_JWT_EXP=3h
CHATTER_JWT_SECRET_REFRESH=koira
CHATTER_JWT_EXP_REFRESH=7d
CHATTER_JWT_ISSUER=https://local.purgatoryforcookies.com
CHATTER_CLIENT_PROXY=
CHATTER_AWS_EXECUTION_ENV=
CHATTER_DAO_DB_TLS_CERT=
CHATTER_REDISCLIENT_DB_TLS_CERT=
CHATTER_OIDCPROVIDER_HTTP_TIMEOUT=
