{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "oxlint",
    "test": "node -e \"fs.rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.json --outDir dist-test && node --test \"dist-test/**/*.test.js\"",
    "knip": "knip --include files,exports,types"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.6",
    "@types/pg": "^8.23.1",
    "knip": "^6.39.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
