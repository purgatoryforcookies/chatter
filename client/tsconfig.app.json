{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "../types.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": null,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}